# TYFZA1（Realtek RTL9617C）专用构建仓库的版本钉。
# 规则：只按 SHA/标签取，不用 @latest；每条都要能用公开 API 复核。

# —— 基座：官方稳定版 ——
# 用户要求 25.12.6 稳定版。实测（GitHub contents API）：
#   target/linux/generic/kernel-6.12 存在，kernel-6.18 只存在于 master；
#   官方 realtek 目标只有 rtl838x/839x/930x/931x，没有 rtl9617c。
# 所以本仓库第一件事是 base-probe：验"25.12.6 + rtl9617c 端口"到底走到哪一步失败。
OPENWRT_URL=https://github.com/openwrt/openwrt.git
OPENWRT_REF=v25.12.6

# —— 开源 TYFZA1 适配（不 fork，按 SHA 取，只读复用）——
# 网上开源面实测就这些：
#   LeoooChen/PonWRT-TYFZA1        53★ 端口本体（kernel/无线/PE/包），2026-11-03 有 fix(wifi)
#   LeoooChen/U-Boot-TYFZA1        14★ 原生 U-Boot 与网页恢复（刷写前置）
#   lyq1996/rtl9617c-uboot          5★ 另一套 uboot（2026-11-04 仍在推）
#   lyq1996/rtl9617c-factory        2★ 原厂分区/备份相关
#   lyq1996/rtl9617c-migration-tools 2★ 迁移工具
PORT_URL=https://github.com/LeoooChen/PonWRT-TYFZA1
PORT_SHA=7fc118d2d03b2d1d0227bfdb8e51611f91ad8769
PORT_KERNEL_PATCHVER=6.18          # 端口 target Makefile 里的声明，探针会打印实际支持情况

UBOOT_URL=https://github.com/LeoooChen/U-Boot-TYFZA1
UBOOT_SHA=                         # 需要时再钉（刷写 kit 用，不影响固件构建）

# —— 我们自己追加的东西（用户要求：只加这些，别的按上游）——
THEME_URL=https://github.com/likz0421/luci-theme-lucent
THEME_SHA=dd8dc3fb60d7b26efb7b0ddb39ef078f9821e41f     # release: point latest files to v3.10.9

HONK_VERSION=0.1.0-beta.5
HONK_PKG_VERSION=0.1.0_beta5       # apk 版本串里 - 只能出现一次（revision 分隔符）
HONK_ASSET=honk-core-v0.1.0-beta.5-aarch64-unknown-linux-musl-full.tar.gz
HONK_URL=https://github.com/daeuniverse/honk/releases/download/v0.1.0-beta.5/honk-core-v0.1.0-beta.5-aarch64-unknown-linux-musl-full.tar.gz
HONK_SHA256=6e06b12c05f775744b4cc65f80d29ae486e65f4a433d2878b197703d8f83e7ae
DAEUNIV_URL=https://github.com/daeuniverse/openwrt-packages
DAEUNIV_SHA=e48b222f239e2572244c8cf495fbce79b0da7528   # build(honk): move to v0.1.0-beta.5
DAEUNIV_KEY_SHA256=5aae30568b7e08f86ea3e72a19fa281d835ba4eff8ab38849abcd2b0884c6cd5
