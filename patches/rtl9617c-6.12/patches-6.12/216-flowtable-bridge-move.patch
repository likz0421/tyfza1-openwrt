+/* Called under the flowtable lookup/iterator RCU read section. A bridge
+ * move invalidates the whole connection, including its reverse HW rule. */
+static bool nf_flow_bridge_changed(const struct flow_offload *flow)
+{
+	struct net *net = nf_ct_net(flow->ct);
+	unsigned int dir;
+
+	if (flow->type != NF_FLOW_OFFLOAD_ROUTE)
+		return false;
+	for (dir = 0; dir < FLOW_OFFLOAD_DIR_MAX; dir++) {
+		const struct flow_offload_tuple *tuple = &flow->tuplehash[dir].tuple;
+		struct net_device *bridge, *port;
+
+		if (tuple->xmit_type != FLOW_OFFLOAD_XMIT_DIRECT || !tuple->out.bridge_ifidx)
+			continue;
+		bridge = dev_get_by_index_rcu(net, tuple->out.bridge_ifidx);
+		if (!bridge)
+			return true;
+		port = br_fdb_find_port_rcu(bridge, tuple->out.h_dest, tuple->out.bridge_vid);
+		if (!port || port->ifindex != tuple->out.bridge_port)
+			return true;
+	}
+	return false;
+}
